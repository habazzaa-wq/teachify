# Base URL of the Laravel API (without /api/v1 suffix).
# The axios client appends /api/v1 automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public application name shown in the UI and document title.
NEXT_PUBLIC_APP_NAME=أكاديميتي

# Base domain for generating tenant subdomain URLs (e.g., hazem.academy.test).
NEXT_PUBLIC_APP_BASE_DOMAIN=academy.test

# Local dev: auto-select tenant so login works without a tenant picker UI.
# NEXT_PUBLIC_DEV_TENANT_ID=1
# NEXT_PUBLIC_DEV_TENANT_NAME=أكاديمية تجريبية
# NEXT_PUBLIC_DEV_TENANT_SLUG=demo
# NEXT_PUBLIC_DEV_TENANT_STATUS=active
