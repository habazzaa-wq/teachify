APP_NAME=Teachify
APP_ENV=production
APP_DEBUG=false
APP_URL=https://teachify.tech

# APP_KEY, DB_PASSWORD, and SUPERADMIN_PASSWORD are managed directly
# in the server's .env file. Do NOT add them here — they would override
# the real values when Laravel loads .env.production on top of .env.

APP_BASE_DOMAIN=teachify.tech

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=teachify
DB_USERNAME=teachify_user

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.teachify.tech
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@teachify.tech"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=teachify.tech,www.teachify.tech,localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

CORS_ALLOWED_ORIGINS=https://teachify.tech,https://www.teachify.tech

SUPERADMIN_EMAIL=admin@teachify.tech
# SUPERADMIN_PASSWORD is managed directly in the server .env file.

VITE_APP_NAME="${APP_NAME}"
NEXT_PUBLIC_API_URL=https://teachify.tech
