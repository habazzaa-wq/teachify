APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_saas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_DOMAIN=.academy.test      # ← set for cross-subdomain cookies (production)
# SESSION_SECURE_COOKIE=true         # ← set for HTTPS (production)

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated SPA origins for Sanctum/CORS (must match the Next.js dev URL).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# Comma-separated SPA origins for CORS headers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base domain for generating tenant subdomain URLs.
# Used to build tenant URLs like {slug}.{base_domain}.
# Examples: academy.test, teachify.tech, localhost
APP_BASE_DOMAIN=academy.test

# Secret protecting the Caddy on-demand TLS domain-check endpoint
# (GET /api/v1/platform/domain-check?secret=...&domain={hostname}).
# Must match the secret Caddy passes in its on_demand_tls ask URL.
DOMAIN_CHECK_SECRET=

# Super-admin credentials (used by SuperAdminUserSeeder).
SUPERADMIN_EMAIL=admin@platform.com
SUPERADMIN_PASSWORD=change_me

# Realtime broadcasting (Reverb WebSocket server)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=community-app
REVERB_APP_KEY=techify-reverb-key
REVERB_APP_SECRET=techify-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Permanent user assets (avatars, scanned question images, media-library
# fallback). Defaults to "public" (node-local). Set to a shared disk (e.g.
# "s3") for multi-node deployments. Existing local files keep working.
MEDIA_STORAGE_DISK=public

# Request correlation / observability.
REQUEST_ID_HEADER=X-Request-Id
SLOW_REQUEST_THRESHOLD_MS=1000
SLOW_QUERY_THRESHOLD_MS=200
READINESS_CHECK_CACHE=true
