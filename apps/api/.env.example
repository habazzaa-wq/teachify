APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_saas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_DOMAIN=.academy.test      # ← set for cross-subdomain cookies (production)
# SESSION_SECURE_COOKIE=true         # ← set for HTTPS (production)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated SPA origins for Sanctum/CORS (must match the Next.js dev URL).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# Comma-separated SPA origins for CORS headers.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base domain for generating tenant subdomain URLs.
# Used to build tenant URLs like {slug}.{base_domain}.
# Examples: academy.test, teachify.tech, localhost
APP_BASE_DOMAIN=academy.test

# Platform domain for custom domain support.
PLATFORM_DOMAIN=academy.test

# Production server IPs for DNS verification of custom domains.
SERVER_IP=
SERVER_IPV6=

# Caddy admin API URL for certificate management.
CADDY_ADMIN_URL=http://127.0.0.1:2019

# Shared secret for Caddy on-demand TLS ask endpoint.
# Generate with: openssl rand -hex 32
CADDY_ASK_SECRET=

# Super-admin credentials (used by SuperAdminUserSeeder).
SUPERADMIN_EMAIL=admin@platform.com
SUPERADMIN_PASSWORD=change_me
