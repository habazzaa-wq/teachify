# =============================================================================
# Custom tenant domain vhost — template
#
# Rendered by scripts/provision-custom-domain.sh. Do NOT edit the rendered file
# on the server by hand: edit this template and re-run the provisioning script
# so every custom domain gets the exact same routing contract.
#
# Routing contract for a custom tenant domain (same-origin tenant site):
#
#   /api/*      -> Laravel API  (php-fpm)
#   /sanctum/*  -> Laravel API  (php-fpm)
#   /*          -> Next.js SSR  (127.0.0.1:3000)
#
# Why /api MUST NOT be proxied to Next.js:
# the Next.js app has no /api routes in production (the rewrites in
# next.config.ts are dev-only), so a request to /api/v1/tenant/by-domain would
# return the HTML 404 page of the SPA. The tenant bootstrap would then read
# that HTML as "the academy does not exist" and the whole tenant site (login,
# courses, media) would be broken. The API therefore has to be served by
# Laravel on the very same origin, which also removes any need for CORS.
# =============================================================================

# ── HTTP -> HTTPS redirect (+ ACME challenge) ──
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    # Let's Encrypt http-01 validation must stay reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root __CERTBOT_ROOT__;
    }

    location / {
        return 301 https://__DOMAIN__$request_uri;
    }
}

# ── HTTPS: tenant site ──
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    # Laravel public root: serves /storage/* and the PHP front controller.
    root __API_ROOT__;
    index index.php;

    # ── SSL ──
    ssl_certificate __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # ── Security headers ──
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ── Uploads (media library) ──
    client_max_body_size 500M;

    # ── Laravel API (same origin as the frontend) ──
    location /api {
        try_files $uri /index.php?$query_string;
    }

    location /sanctum {
        try_files $uri /index.php?$query_string;
    }

    location ~ ^/index\.php(/|$) {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:__PHP_FPM_SOCK__;
        fastcgi_param SCRIPT_FILENAME __API_ROOT__/index.php;
    }

    # ── Next.js static assets ──
    location /_next/static/ {
        proxy_pass __NEXT_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Next.js SSR ──
    location / {
        proxy_pass __NEXT_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
